#!/usr/bin/env bash
set -euo pipefail

export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

if [[ -f "$HOME/.zprofile" ]]; then
  # shellcheck disable=SC1090
  source "$HOME/.zprofile"
fi

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$ROOT/src${PYTHONPATH:+:$PYTHONPATH}"

usage() {
  cat >&2 <<'EOF'
usage:
  leadops-swiftbar run-daily <workspace> [run-daily args...]
  leadops-swiftbar send-digest <workspace> <date>
  leadops-swiftbar mark-status <workspace> <target_id> <status> [extra args...]
  leadops-swiftbar copy-draft <workspace> <packet_date> <target_id>
  leadops-swiftbar pause-schedule <workspace> [label]
  leadops-swiftbar resume-schedule <workspace> [label]
EOF
  exit 2
}

if [[ $# -lt 2 ]]; then
  usage
fi

action="$1"
shift
workspace="$1"
shift

log_dir="$workspace/var/log"
mkdir -p "$log_dir"

case "$action" in
  run-daily)
    "$ROOT/bin/leadops-daily" "$workspace" "$@" >>"$log_dir/manual-run.log" 2>&1 &
    sleep 1
    ;;
  send-digest)
    if [[ $# -lt 1 ]]; then
      usage
    fi
    packet_date="$1"
    shift
    python3 -m leadops send-digest --workspace "$workspace" --date "$packet_date" "$@" >>"$log_dir/manual-digest.log" 2>&1 &
    sleep 1
    ;;
  mark-status)
    if [[ $# -lt 2 ]]; then
      usage
    fi
    target_id="$1"
    status="$2"
    shift 2
    exec python3 -m leadops mark-status --workspace "$workspace" "$target_id" "$status" "$@"
    ;;
  copy-draft)
    if [[ $# -lt 2 ]]; then
      usage
    fi
    packet_date="$1"
    target_id="$2"
    shift 2
    exec python3 - "$workspace" "$packet_date" "$target_id" <<'PY'
import json
import subprocess
import sys
from pathlib import Path

workspace = Path(sys.argv[1]).expanduser()
packet_date = sys.argv[2]
target_id = int(sys.argv[3])
packet_path = workspace / "outbox" / packet_date / "daily-brief.json"
if not packet_path.exists():
    raise SystemExit(f"Missing packet: {packet_path}")

payload = json.loads(packet_path.read_text(encoding="utf-8"))
queues = payload.get("queues", {})
items = []
for queue_name in ("pursue_now", "watch", "nurture", "followup_due"):
    queue_items = queues.get(queue_name, [])
    if isinstance(queue_items, list):
        items.extend(queue_items)
for item in items:
    target = item.get("target", {})
    if int(target.get("id", 0) or 0) != target_id:
        continue
    assessment = item.get("assessment", {})
    subject = str(assessment.get("draft_subject", "") or "").strip()
    body = str(assessment.get("draft_body", "") or "").strip()
    full_draft = f"Subject: {subject}\n\n{body}".strip()
    subprocess.run(["/usr/bin/pbcopy"], input=full_draft, text=True, check=True)
    raise SystemExit(0)

raise SystemExit(f"Target {target_id} not found in packet {packet_date}")
PY
    ;;
  pause-schedule)
    label="${1:-${LEADOPS_LAUNCHD_LABEL:-dev.leadops.daily}}"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    paused="$HOME/Library/LaunchAgents/$label.plist.paused"
    launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
    if [[ -f "$plist" ]]; then
      if [[ -f "$paused" ]]; then
        rm -f "$paused"
      fi
      mv "$plist" "$paused"
    fi
    ;;
  resume-schedule)
    label="${1:-${LEADOPS_LAUNCHD_LABEL:-dev.leadops.daily}}"
    plist="$HOME/Library/LaunchAgents/$label.plist"
    paused="$HOME/Library/LaunchAgents/$label.plist.paused"
    if [[ -f "$paused" ]]; then
      python3 - "$paused" "$workspace" <<'PY'
import plistlib
import sys
from pathlib import Path
import tomllib

path = Path(sys.argv[1])
workspace = Path(sys.argv[2]).expanduser()
with path.open("rb") as handle:
    payload = plistlib.load(handle)

args = list(payload.get("ProgramArguments", []))
legacy_approaches = {
    "builder_need": "transition_focus",
    "early_product": "balanced",
    "place_watch": "public_signal_watch",
}
for index, value in enumerate(args[:-1]):
    if value == "--approach":
        next_value = args[index + 1]
        mapped = legacy_approaches.get(next_value)
        if mapped:
            args[index + 1] = mapped

config_path = workspace / "leadops.toml"
send_on_run = False
if config_path.exists():
    with config_path.open("rb") as handle:
        config = tomllib.load(handle)
    send_on_run = bool(config.get("email", {}).get("send_on_run", False))
if not send_on_run:
    args = [arg for arg in args if arg != "--send-digest"]
payload["ProgramArguments"] = args
path.write_bytes(plistlib.dumps(payload, sort_keys=False))
PY
      if [[ -f "$plist" ]]; then
        launchctl bootout "gui/$(id -u)" "$plist" >/dev/null 2>&1 || true
        rm -f "$plist"
      fi
      mv "$paused" "$plist"
    fi
    if [[ ! -f "$plist" ]]; then
      echo "Missing launch agent plist for $label." >&2
      exit 1
    fi
    launchctl bootstrap "gui/$(id -u)" "$plist"
    ;;
  *)
    usage
    ;;
esac
